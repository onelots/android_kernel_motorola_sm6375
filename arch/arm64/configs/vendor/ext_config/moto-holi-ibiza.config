#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_IBIZA_DTB=y

# Camera
CONFIG_CAM_SENSOR_PROBE_RETRY=y

# Charger
CONFIG_QG_LEGACY=y

# UFS
# CONFIG_UFSFEATURE is not set
# CONFIG_UFSHPB is not set
# CONFIG_UFSTW is not set
# CONFIG_SCSI_SKHPB is not set
# CONFIG_UFSTW_IGNORE_GUARANTEE_BIT is not set
# CONFIG_UFSTW_BOOT_ENABLED is not set
# CONFIG_MICRON_HPB is not set
# CONFIG_UFSHID is not set
# CONFIG_UFSHID_POC is not set
# CONFIG_SCSI_SKHID is not set
# CONFIG_MICRON_UFSHID is not set

# Legitimate, will refactor later
CONFIG_MMI_RELAY=m
CONFIG_MMI_INFO=m
CONFIG_MMI_ANNOTATE=m
CONFIG_SENSORS_CLASS=m
CONFIG_MOTO_F_USBNET=m
CONFIG_WATCHDOGTEST=m
CONFIG_QPNP_ADAPTIVE_CHARGE=m
CONFIG_FPSENSOR_SPI_TEE=m
CONFIG_SARSENSOR_SX937X=m
CONFIG_MMI_SYS_TEMP=m
CONFIG_MMI_SMBCHARGER_IIO=m
CONFIG_REGULATOR_WL2864C=m 
CONFIG_CAMERA_CCI_INTF=m
CONFIG_NFC_QTI_I2C=m
CONFIG_MOTO_UTAGS=m

# Fingerprint Sensor
CONFIG_INPUT_CHIPONE_FPS_MMI=m
CONFIG_INPUT_CHIPONE_FPS_MMI_SUPPORT_POWER_GPIO=y
CONFIG_INPUT_MISC_FPC1020=m
CONFIG_INPUT_MISC_FPC1020_SAVE_TO_CLASS_DEVICE=y

# Yeah more mess again but from anierin so it's okay
CONFIG_TOUCHSCREEN_CHIPONE_TDDI=m
CONFIG_TOUCHSCREEN_CHIPONE_TDDI_ESD=y
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI_MMI=m

Yes needed and fix fuel gauge
CONFIG_QCOM_POWER_SUPPLY=y
CONFIG_QPNP_QG=m
# CONFIG_SMB1398_CHARGER is not set
# CONFIG_SMB1355_SLAVE_CHARGER is not set

# Trying stuff here (kanged from fogos lol cope)
# Camera
CONFIG_AF_NOISE_ELIMINATION=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_CAMERA_CCI_INTF=m
CONFIG_CAMERA_FLASH_IIC_COMPATIBLE=y
CONFIG_MOT_DONGWOON_OIS_AF_DRIFT=y
CONFIG_MOT_SECURE_CAMERA=y
CONFIG_MOT_SENSOR_PRE_POWERUP=y

# Audio ? (will never work but well)
CONFIG_SND_SOC_FS1815=m
ONFIG_SND_SOC_AUTO=y
